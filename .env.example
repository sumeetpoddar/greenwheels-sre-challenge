
# PostgreSQL configuration
POSTGRES_DB=greenwheels
POSTGRES_USER=greenwheels
POSTGRES_PASSWORD=replace_me_local_password

# FastAPI database connection
DATABASE_URL=postgresql+psycopg://greenwheels:replace_me_local_password@postgres:5432/greenwheels

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Grafana administrator credentials (local development only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_local_password
